{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gl/config-version.schema.json",
  "title": "GL configuration version (C1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tenantId",
    "configId",
    "version",
    "status",
    "effectiveFrom",
    "content"
  ],
  "properties": {
    "schemaVersion": {
      "const": "gl.config/v1"
    },
    "tenantId": {
      "$ref": "#/$defs/code"
    },
    "configId": {
      "$ref": "#/$defs/code"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "validated",
        "approved",
        "retired"
      ]
    },
    "effectiveFrom": {
      "$ref": "#/$defs/date"
    },
    "effectiveTo": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "contentDigest": {
      "$ref": "#/$defs/digest"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submittedBy"
      ],
      "properties": {
        "submittedBy": {
          "type": "string",
          "minLength": 1
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceSystems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceSystem"
          }
        },
        "sourceAuthority": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceAuthority"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/eventType"
          },
          "description": "US-005: the financial event catalog"
        },
        "baseMeasures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/baseMeasure"
          },
          "description": "US-006: adopt/override OOTB measures, or define custom ones"
        },
        "derivedMeasures": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Detailed by US-007"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Detailed by US-008"
        },
        "lookups": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Detailed by US-008"
        },
        "datePolicies": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Detailed by US-009"
        },
        "calendars": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Detailed by US-009"
        },
        "keyProfiles": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Detailed by US-010"
        },
        "accountingClasses": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Detailed by US-011"
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Detailed by US-011"
        },
        "postingRules": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Detailed by US-012"
        },
        "accountAssignmentRules": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Detailed by US-013"
        },
        "reconciliationEquations": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Detailed by US-028"
        },
        "outputProfiles": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Detailed by US-039"
        }
      }
    }
  },
  "$defs": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "kind"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "kind": {
          "enum": [
            "POLICY",
            "BILLING",
            "CLAIMS",
            "EARNINGS",
            "SOURCE_JOURNAL",
            "CUSTOM"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventType",
        "measure",
        "sourceSystem",
        "intakeMode"
      ],
      "properties": {
        "eventType": {
          "$ref": "#/$defs/code"
        },
        "measure": {
          "oneOf": [
            {
              "$ref": "#/$defs/code"
            },
            {
              "const": "*"
            }
          ],
          "description": "A measure of the event, or * for all its measures; a specific entry takes precedence over *"
        },
        "sourceSystem": {
          "$ref": "#/$defs/code"
        },
        "intakeMode": {
          "enum": [
            "RAW_EVENT",
            "SOURCE_JOURNAL"
          ]
        },
        "effectiveFrom": {
          "$ref": "#/$defs/date"
        },
        "effectiveTo": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "eventType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "economicKey"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "description": {
          "type": "string"
        },
        "economicKey": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/code"
          },
          "description": "Fields whose values identify the economic event: economicEventKey = <code>:<value>:..."
        },
        "measures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          },
          "description": "Measures carried once per event"
        },
        "lists": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "itemKey"
            ],
            "properties": {
              "code": {
                "$ref": "#/$defs/code"
              },
              "itemKey": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/code"
                }
              },
              "keys": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/code"
                }
              },
              "measures": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/code"
                },
                "description": "Measures carried once per item, never multiplied into the parent"
              }
            }
          }
        }
      }
    },
    "baseMeasure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "custom": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "dataType": {
          "enum": [
            "AMOUNT",
            "QUANTITY",
            "RATE",
            "COUNT"
          ]
        },
        "sign": {
          "enum": [
            "POSITIVE",
            "NEGATIVE",
            "SIGNED"
          ]
        },
        "currency": {
          "enum": [
            "EVENT",
            "NONE"
          ]
        },
        "grain": {
          "enum": [
            "EVENT",
            "ITEM",
            "ANY"
          ]
        },
        "sourceScope": {
          "type": "array",
          "items": {
            "enum": [
              "POLICY",
              "BILLING",
              "CLAIMS",
              "EARNINGS",
              "SOURCE_JOURNAL",
              "CUSTOM"
            ]
          }
        }
      },
      "description": "No account or side: a base measure is not a posting."
    }
  }
}
