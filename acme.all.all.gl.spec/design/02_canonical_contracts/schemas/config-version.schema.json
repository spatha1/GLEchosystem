{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gl/config-version.schema.json",
  "title": "GL configuration version (C1)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tenantId",
    "configId",
    "version",
    "status",
    "effectiveFrom",
    "content"
  ],
  "properties": {
    "schemaVersion": {
      "const": "gl.config/v1"
    },
    "tenantId": {
      "$ref": "#/$defs/code"
    },
    "configId": {
      "$ref": "#/$defs/code"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "validated",
        "approved",
        "retired"
      ]
    },
    "effectiveFrom": {
      "$ref": "#/$defs/date"
    },
    "effectiveTo": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "contentDigest": {
      "$ref": "#/$defs/digest"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submittedBy"
      ],
      "properties": {
        "submittedBy": {
          "type": "string",
          "minLength": 1
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1
        },
        "approvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceSystems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceSystem"
          }
        },
        "sourceAuthority": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceAuthority"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/eventType"
          },
          "description": "US-005: the financial event catalog"
        },
        "baseMeasures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/baseMeasure"
          },
          "description": "US-006: adopt/override OOTB measures, or define custom ones"
        },
        "derivedMeasures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/derivedMeasure"
          },
          "description": "US-007: formulas over measures, in the bounded GL formula language"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dimension"
          },
          "description": "US-008"
        },
        "lookups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lookup"
          },
          "description": "US-008: derived dimensions"
        },
        "datePolicies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/datePolicy"
          },
          "description": "US-009"
        },
        "calendars": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/calendar"
          },
          "description": "US-009"
        },
        "keyProfiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyProfile"
          },
          "description": "US-010: business keys, scopes and ownership links"
        },
        "accountingClasses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/accountingClass"
          },
          "description": "US-011: semantic accounting roles (AR0, PW0, TX0, …)"
        },
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/account"
          },
          "description": "US-011: the client's chart of accounts, each account serving one class"
        },
        "postingRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/postingRule"
          },
          "description": "US-012: event → journal legs, as data"
        },
        "accountAssignmentRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assignmentRule"
          },
          "description": "US-013: class + dimensions → account"
        },
        "reconciliationEquations": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Detailed by US-028"
        },
        "outputProfiles": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Detailed by US-039"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scenario"
          },
          "description": "Simulation scenarios: synthetic events and the journals they must produce, versioned with the rules they test"
        }
      }
    }
  },
  "$defs": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sourceSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "kind"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "kind": {
          "enum": [
            "POLICY",
            "BILLING",
            "CLAIMS",
            "EARNINGS",
            "REINSURANCE",
            "SOURCE_JOURNAL",
            "CUSTOM"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventType",
        "measure",
        "sourceSystem",
        "intakeMode"
      ],
      "properties": {
        "eventType": {
          "$ref": "#/$defs/code"
        },
        "measure": {
          "oneOf": [
            {
              "$ref": "#/$defs/code"
            },
            {
              "const": "*"
            }
          ],
          "description": "A measure of the event, or * for all its measures; a specific entry takes precedence over *"
        },
        "sourceSystem": {
          "$ref": "#/$defs/code"
        },
        "intakeMode": {
          "enum": [
            "RAW_EVENT",
            "SOURCE_JOURNAL"
          ]
        },
        "effectiveFrom": {
          "$ref": "#/$defs/date"
        },
        "effectiveTo": {
          "$ref": "#/$defs/date"
        }
      }
    },
    "eventType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "economicKey"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "description": {
          "type": "string"
        },
        "economicKey": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/code"
          },
          "description": "Fields whose values identify the economic event: economicEventKey = <code>:<value>:..."
        },
        "measures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          },
          "description": "Measures carried once per event"
        },
        "lists": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "itemKey"
            ],
            "properties": {
              "code": {
                "$ref": "#/$defs/code"
              },
              "itemKey": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/code"
                }
              },
              "keys": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/code"
                },
                "description": "Linkage keys per item, e.g. INVOICE_NO on an allocation"
              },
              "measures": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/code"
                },
                "description": "Measures carried once per item, never multiplied into the parent"
              }
            }
          }
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          },
          "description": "Dimensions the event carries (US-008)"
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          },
          "description": "US-010: business keys carried at event level (default: the economic key); an undeclared key is INVALID_KEY"
        }
      }
    },
    "baseMeasure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "custom": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "dataType": {
          "enum": [
            "AMOUNT",
            "QUANTITY",
            "RATE",
            "COUNT"
          ]
        },
        "sign": {
          "enum": [
            "POSITIVE",
            "NEGATIVE",
            "SIGNED"
          ]
        },
        "currency": {
          "enum": [
            "EVENT",
            "NONE"
          ]
        },
        "grain": {
          "enum": [
            "EVENT",
            "ITEM",
            "ANY"
          ]
        },
        "sourceScope": {
          "type": "array",
          "items": {
            "enum": [
              "POLICY",
              "BILLING",
              "CLAIMS",
              "EARNINGS",
              "REINSURANCE",
              "SOURCE_JOURNAL",
              "CUSTOM"
            ]
          }
        }
      },
      "description": "No account or side: a base measure is not a posting."
    },
    "derivedMeasure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "formula",
        "resultType"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "description": {
          "type": "string"
        },
        "formula": {
          "type": "string",
          "maxLength": 4096
        },
        "resultType": {
          "enum": [
            "AMOUNT",
            "NUMBER",
            "BOOL",
            "STRING",
            "DATE"
          ]
        },
        "eventTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          }
        }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "custom": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "open": {
          "type": "boolean"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "normalizations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceSystem",
              "map"
            ],
            "properties": {
              "sourceSystem": {
                "$ref": "#/$defs/code"
              },
              "caseInsensitive": {
                "type": "boolean"
              },
              "map": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "derivedBy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lookup"
          ],
          "properties": {
            "lookup": {
              "$ref": "#/$defs/code"
            }
          }
        }
      }
    },
    "lookup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "input",
        "output",
        "entries"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "description": {
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/code"
        },
        "output": {
          "$ref": "#/$defs/code"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "value"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "effectiveFrom": {
                "$ref": "#/$defs/date"
              },
              "effectiveTo": {
                "$ref": "#/$defs/date"
              }
            }
          }
        }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "timezone"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "timezone": {
          "type": "string",
          "description": "IANA time zone"
        },
        "weekend": {
          "type": "array",
          "items": {
            "enum": [
              "MON",
              "TUE",
              "WED",
              "THU",
              "FRI",
              "SAT",
              "SUN"
            ]
          }
        },
        "holidays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/date"
          }
        }
      }
    },
    "datePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "calendar",
        "bookDate"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "eventTypes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          }
        },
        "calendar": {
          "$ref": "#/$defs/code"
        },
        "bookDate": {
          "enum": [
            "TRANSACTION_DATE",
            "EFFECTIVE_DATE",
            "RECORDED_DATE"
          ]
        },
        "businessDayRule": {
          "enum": [
            "NONE",
            "NEXT_BUSINESS_DAY"
          ]
        },
        "fiscalYearStartMonth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "advance": {
          "type": "boolean"
        },
        "lookupDate": {
          "enum": [
            "TRANSACTION_DATE",
            "EFFECTIVE_DATE"
          ]
        },
        "closeAfterBusinessDay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "latePolicy": {
          "enum": [
            "NEXT_OPEN_PERIOD",
            "REJECT"
          ]
        }
      }
    },
    "keyProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "description": {
          "type": "string"
        },
        "pattern": {
          "type": "string",
          "description": "A value must match it entirely (RE2 syntax)"
        },
        "caseInsensitive": {
          "type": "boolean",
          "description": "Values are compared upper-cased"
        },
        "scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          },
          "description": "The value is unique only within these keys, e.g. TERM_NO within POLICY_NO; graph values are qualified as \"P1/1\""
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "to",
              "cardinality"
            ],
            "properties": {
              "to": {
                "$ref": "#/$defs/code"
              },
              "cardinality": {
                "enum": [
                  "MANY_TO_ONE",
                  "ONE_TO_ONE",
                  "MANY_TO_MANY"
                ],
                "description": "MANY_TO_ONE and ONE_TO_ONE are ownership: the target is the parent, and a value has one parent of that key"
              }
            }
          }
        }
      }
    },
    "accountingClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "nature"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "nature": {
          "enum": [
            "ASSET",
            "LIABILITY",
            "EQUITY",
            "INCOME",
            "EXPENSE"
          ]
        },
        "normalSide": {
          "enum": [
            "D",
            "C"
          ],
          "description": "Default: D for ASSET and EXPENSE, C otherwise"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "class",
        "activeFrom"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$",
          "description": "The client's ledger code; unique per ledger"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "$ref": "#/$defs/code"
        },
        "ledger": {
          "$ref": "#/$defs/code",
          "description": "Default PRIMARY"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          },
          "description": "Legal entities (COMPANY values) that may post; empty: all"
        },
        "currencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "description": "Transaction currencies accepted; empty: all"
        },
        "activeFrom": {
          "$ref": "#/$defs/date"
        },
        "activeTo": {
          "$ref": "#/$defs/date",
          "description": "Exclusive"
        },
        "subledgerKey": {
          "$ref": "#/$defs/code",
          "description": "A key profile (US-010) every line must carry"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code"
          },
          "description": "Dimensions every line must carry"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "lineTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "class",
        "side",
        "amount"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "class": {
          "$ref": "#/$defs/code",
          "description": "Accounting class (US-011); the account is assigned by US-013"
        },
        "side": {
          "enum": [
            "D",
            "C"
          ]
        },
        "amount": {
          "type": "string",
          "minLength": 1,
          "description": "AMOUNT formula (US-007); a negative result flips the side; must be exact at the currency minor units (ROUND explicitly)"
        },
        "expandBy": {
          "$ref": "#/$defs/code",
          "description": "A list of the event: one line per item, reading the item's measures"
        },
        "entity": {
          "type": "string",
          "description": "STRING formula overriding the legal entity (default: the COMPANY dimension), e.g. BANKING_COMPANY"
        },
        "when": {
          "type": "string",
          "description": "BOOL formula; the line is produced only when true"
        },
        "explanation": {
          "type": "string"
        }
      }
    },
    "postingRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "eventType",
        "rank",
        "lines"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "description": {
          "type": "string"
        },
        "eventType": {
          "$ref": "#/$defs/code"
        },
        "filter": {
          "type": "string",
          "description": "BOOL formula; empty: every event of the type"
        },
        "rank": {
          "type": "integer",
          "description": "Among matching rules the lowest rank applies; a tie is AMBIGUOUS_RULE"
        },
        "lines": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/lineTemplate"
          },
          "description": "At least one debit and one credit"
        },
        "active": {
          "type": "boolean",
          "description": "false keeps the rule in the version for the record but never applies it (default true)"
        },
        "effectiveFrom": {
          "type": "string",
          "format": "date",
          "description": "Within the version, the rule applies to book dates from this date"
        },
        "effectiveTo": {
          "type": "string",
          "format": "date",
          "description": "Exclusive end of the rule's window; same-rank rules may not overlap"
        }
      }
    },
    "assignmentRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "class",
        "account"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code"
        },
        "description": {
          "type": "string"
        },
        "class": {
          "$ref": "#/$defs/code"
        },
        "match": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/code"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "Dimension (or ENTITY, CURRENCY, BOOKING_CLASS) → exact value, or \"*\" for any present value; unnamed dimensions do not matter"
        },
        "account": {
          "type": "string",
          "description": "An account of the class in the ledger (US-011)"
        },
        "ledger": {
          "$ref": "#/$defs/code",
          "description": "Default PRIMARY"
        },
        "priority": {
          "type": "integer",
          "description": "Lower first, before specificity; default 0"
        },
        "effectiveFrom": {
          "$ref": "#/$defs/date"
        },
        "effectiveTo": {
          "$ref": "#/$defs/date",
          "description": "Exclusive"
        }
      },
      "description": "Precedence: priority, then exact matches, then wildcards, then the later effectiveFrom; an equal-precedence overlap is AMBIGUOUS_ASSIGNMENT"
    },
    "expectedLeg": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "side",
        "amount"
      ],
      "properties": {
        "class": {
          "$ref": "#/$defs/code"
        },
        "side": {
          "enum": [
            "D",
            "C"
          ]
        },
        "amount": {
          "type": "string",
          "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
        },
        "entity": {
          "type": "string"
        },
        "account": {
          "type": "string"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "eventType",
        "input"
      ],
      "properties": {
