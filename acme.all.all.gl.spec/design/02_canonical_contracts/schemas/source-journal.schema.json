{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gl/source-journal.schema.json",
  "title": "Pre-balanced source journal (C5)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tenantId", "sourceSystem", "sourceJournalId", "sourceJournalVersion", "economicEventKey", "eventType", "company", "currency", "bookingDate", "lines", "sourceRowIds"],
  "properties": {
    "schemaVersion": { "const": "gl.source-journal/v1" },
    "tenantId": { "$ref": "#/$defs/code" },
    "sourceSystem": { "$ref": "#/$defs/code" },
    "sourceJournalId": { "type": "string", "minLength": 1 },
    "sourceJournalVersion": { "type": "integer", "minimum": 1 },
    "economicEventKey": { "type": "string", "minLength": 1 },
    "eventType": { "$ref": "#/$defs/code" },
    "company": { "type": "string", "minLength": 1 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "bookingDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "lines": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceLineId", "accountRef", "side", "amount"],
        "properties": {
          "sourceLineId": { "type": "string", "minLength": 1 },
          "accountRef": { "type": "string", "minLength": 1 },
          "side": { "enum": ["D", "C"] },
          "amount": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
          "dimensions": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    },
    "sourceRowIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "mappingId": { "$ref": "#/$defs/code" },
    "mappingVersion": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
  }
}
